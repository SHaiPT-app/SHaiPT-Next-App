# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Postgres connection string, only for scripts/migrate.ts (Project Settings → Database)
SUPABASE_DB_URL=

# OpenAI (platform.openai.com → API keys). Every call goes through lib/ai/gateway.ts.
OPENAI_API_KEY=
# Models per tier (defaults gpt-5-nano for chat/summaries, gpt-5-mini for plans/nutrition)
AI_MODEL_CHEAP=
AI_MODEL_STRONG=
# Global monthly cap in USD; the gateway refuses calls past it (default 15)
AI_MONTHLY_CAP_USD=15
# Per-user daily limits (defaults 40 calls, 200000 tokens)
AI_DAILY_CALLS_PER_USER=40
AI_DAILY_TOKENS_PER_USER=200000

# Who may read /api/admin/usage (comma-separated emails)
ADMIN_EMAILS=alihomaei1997@gmail.com

# Invite-only sign-up fallback: comma-separated emails allowed to sign up without an invites row
ALLOW_SIGNUP_EMAILS=

# 4Dcoach (film a set, get a 4D replay). Defaults to the sh-ai-pt-simple deployment; on a LAN dev server, port 5174 of the same host.
NEXT_PUBLIC_4DCOACH_URL=

# The in-app MediaPipe pose overlay in the workout logger. Off unless this is 1: it is
# untested, and 4Dcoach covers form through the "Form check in 4D" link on each exercise.
NEXT_PUBLIC_ENABLE_FORM_CHECKER=

# Continue with Google / Continue with Apple on the login screen. Off unless this is 1:
# set it once those providers are configured in Supabase Authentication.
NEXT_PUBLIC_ENABLE_OAUTH=

# Stripe (test mode; testers never reach checkout)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_ELITE=
NEXT_PUBLIC_APP_URL=http://localhost:3000
